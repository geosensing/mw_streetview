\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{working-paper}[2026/11/18 Social science working paper]
% Working-paper adaptation of Kieran Healy's article-1 layout.
% https://github.com/kjhealy/latex-custom-kjh
\RequirePackage[T1]{fontenc}
\RequirePackage[charter,cal=cmcal]{mathdesign}
\RequirePackage[letterpaper,left=1.1in,right=1.1in,top=1in,bottom=1in]{geometry}
\RequirePackage{microtype}
\RequirePackage{setspace}
\setstretch{1.17}
\RequirePackage{titlesec}
\setcounter{secnumdepth}{0}
\titleformat{\section}{\normalfont\Large\bfseries}{}{0pt}{}
\titleformat{\subsection}{\normalfont\large\itshape}{}{0pt}{}
\RequirePackage[round,authoryear]{natbib}
\setcitestyle{round,aysep={},yysep={,},citesep={;}}
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}
\AddToHook{cmd/appendix/after}{%
  \setcounter{secnumdepth}{1}%
  \titleformat{\section}{\normalfont\Large\bfseries}{Appendix~\thesection}{.6em}{}%
  \counterwithin*{table}{section}%
  \counterwithin*{figure}{section}%
  \renewcommand{\thetable}{\thesection\arabic{table}}%
  \renewcommand{\thefigure}{\thesection\arabic{figure}}%
}
\RequirePackage{etoolbox}
\AtEndPreamble{\RequirePackage[hidelinks]{hyperref}}
